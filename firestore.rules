rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(uid) {
      return isVerified() && request.auth.uid == uid;
    }

    function isPortalReadAllowed() {
      return request.time != null;
    }

    function isStrLen(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isOptStrLen(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isOptNum(data, key) {
      return !(key in data) || (data[key] is int || data[key] is float);
    }

    // 3. Entity Validation Blueprints (Strict Schema + Anti-Shadow-Field Protection)
    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'memberId', 'name', 'status']) &&
        data.keys().hasOnly([
          'uid', 'memberId', 'name', 'displayName', 'salutation', 'padNaam', 'designation',
          'phone', 'email', 'password', 'plainPassword',
          'sponsorId', 'sponsorUid', 'sponsorName', 'sponsorPhone',
          'packageTier', 'packageAmount', 'packageName', 'amount', 'donationAmount', 'selfBusiness',
          'selfBusinessCommission', 'walletBalance', 'totalEarned', 'totalWithdrawn',
          'commissionPaid', 'commissionUnpaid', 'commissionStatus', 'lastCommissionPayoutDate',
          'paidPayout', 'unpaidPayout', 'lastPaidAt',
          'directMembersCount', 'directCount', 'downlineMembersCount', 'teamCount',
          'directBusiness', 'directTeamBusiness', 'teamBusiness', 'downlineBusiness',
          'directCommission', 'directTeamCommission', 'downlineCommission', 'totalCommission',
          'lastClosingDate', 'closingHistory',
          'status', 'isApproved', 'paymentVerified', 'kycVerified', 'documentsVerified', 'activatedAt',
          'city', 'state', 'dob', 'bloodGroup', 'occupation', 'qualification', 'gender',
          'fatherOrSpouseName', 'fatherName', 'motherName', 'permanentAddress',
          'permanentPincode', 'currentAddress', 'currentPincode', 'address', 'pincode',
          'photoUrl', 'avatar_url', 'signatureUrl', 'aadhaarDocUrl', 'aadhaarBackDocUrl',
          'panDocUrl', 'paymentReceiptUrl', 'photoDocName', 'signatureDocName',
          'aadhaarDocName', 'aadhaarBackDocName', 'panDocName', 'paymentReceiptName',
          'aadhaarNumber', 'panNumber', 'bankDetails', 'paymentMode', 'paymentMethod',
          'utrNumber', 'officeName1', 'officePhone1', 'officeProposedPost2', 'officePhone2',
          'declarationAccepted', 'applicationDate', 'joiningDate', 'createdAt',
          'timestamp', 'updatedAt', 'role', 'is_admin', 'isAdminMode', 'username'
        ]) &&
        data.uid == userId &&
        isValidId(data.uid) &&
        isStrLen(data.memberId, 2, 64) &&
        isStrLen(data.name, 1, 120) &&
        data.status in ['active', 'pending', 'inactive', 'suspended', 'blocked'] &&
        isOptStrLen(data, 'displayName', 140) &&
        isOptStrLen(data, 'salutation', 20) &&
        isOptStrLen(data, 'padNaam', 120) &&
        isOptStrLen(data, 'phone', 20) &&
        isOptStrLen(data, 'email', 120) &&
        isOptStrLen(data, 'sponsorId', 64) &&
        isOptStrLen(data, 'sponsorName', 140) &&
        isOptStrLen(data, 'sponsorPhone', 20) &&
        isOptStrLen(data, 'photoUrl', 300000) &&
        isOptStrLen(data, 'signatureUrl', 200000) &&
        isOptStrLen(data, 'aadhaarDocUrl', 300000) &&
        isOptStrLen(data, 'aadhaarBackDocUrl', 300000) &&
        isOptStrLen(data, 'panDocUrl', 300000) &&
        isOptStrLen(data, 'paymentReceiptUrl', 300000) &&
        isOptNum(data, 'packageTier') &&
        isOptNum(data, 'packageAmount') &&
        isOptNum(data, 'selfBusiness') &&
        isOptNum(data, 'walletBalance') &&
        isOptNum(data, 'totalEarned') &&
        isOptNum(data, 'totalWithdrawn') &&
        isOptNum(data, 'commissionPaid') &&
        isOptNum(data, 'commissionUnpaid') &&
        isOptNum(data, 'totalCommission') &&
        (!('role' in data) || data.role in ['member', 'admin']) &&
        (!('is_admin' in data) || data.is_admin is bool);
    }

    function isValidPaymentRequest(data, requestId) {
      return data.keys().hasAll(['id', 'userId', 'amount', 'status']) &&
        data.keys().hasOnly([
          'id', 'userId', 'memberId', 'userName', 'email', 'phone', 'sponsorId',
          'amount', 'packageName', 'paymentMode', 'paymentMethod', 'status',
          'utrNumber', 'paymentReceiptUrl', 'aadhaarDocUrl', 'panDocUrl',
          'rejectReason', 'rejectedAt', 'manualCommissionPaid',
          'createdAt', 'timestamp', 'updatedAt', 'approvedAt'
        ]) &&
        data.id == requestId &&
        isValidId(data.id) &&
        isStrLen(data.userId, 1, 128) &&
        (data.amount is int || data.amount is float) &&
        data.amount >= 0 &&
        data.status in ['pending', 'approved', 'rejected'] &&
        isOptStrLen(data, 'memberId', 64) &&
        isOptStrLen(data, 'userName', 140) &&
        isOptStrLen(data, 'utrNumber', 100) &&
        isOptStrLen(data, 'paymentMethod', 80);
    }

    function isValidWithdrawal(data, withdrawalId) {
      return data.keys().hasAll(['id', 'userId', 'amount', 'status']) &&
        data.keys().hasOnly([
          'id', 'userId', 'memberId', 'userName', 'phone', 'amount', 'status',
          'bankDetails', 'bankName', 'accountNo', 'ifsc', 'upiId',
          'payoutMode', 'payoutMethod', 'paidMode', 'adminNote', 'rejectReason', 'rejectedAt',
          'transactionRef', 'remarks', 'createdAt', 'updatedAt', 'paidAt', 'timestamp'
        ]) &&
        data.id == withdrawalId &&
        isValidId(data.id) &&
        isStrLen(data.userId, 1, 128) &&
        (data.amount is int || data.amount is float) &&
        data.amount > 0 &&
        data.status in ['pending', 'approved', 'paid', 'rejected'] &&
        isOptStrLen(data, 'memberId', 64);
    }

    function isValidTransaction(data, txId) {
      return data.keys().hasAll(['id', 'userId', 'type', 'amount']) &&
        data.keys().hasOnly([
          'id', 'userId', 'memberId', 'userName', 'type', 'amount', 'description', 'note',
          'fromMemberId', 'fromName', 'sourceUserId', 'sourceMemberId', 'sourceMemberName',
          'level', 'mode', 'ratePercentage', 'packageAmount',
          'paymentMode', 'paidMode', 'paidAt', 'adminNote', 'status', 'createdAt', 'timestamp'
        ]) &&
        data.id == txId &&
        isValidId(data.id) &&
        isStrLen(data.userId, 1, 128) &&
        isStrLen(data.type, 1, 40) &&
        (data.amount is int || data.amount is float) &&
        isOptStrLen(data, 'description', 300);
    }

    function isValidPayoutRecord(data, recordId) {
      return data.keys().hasAll(['id', 'amount']) &&
        data.keys().hasOnly([
          'id', 'userId', 'memberUid', 'memberId', 'memberName', 'phone', 'referenceId', 'paidBy',
          'sourceUserId', 'sourceMemberId', 'sourceMemberName', 'packageAmount',
          'amount', 'totalDistributed', 'directCommission', 'downlineCommission', 'levelsCount',
          'trustShare', 'payouts', 'distributions', 'status', 'paymentMode', 'referenceNo',
          'remarks', 'date', 'createdAt', 'timestamp'
        ]) &&
        data.id == recordId &&
        isValidId(data.id) &&
        (data.amount is int || data.amount is float) &&
        data.amount >= 0 &&
        isOptStrLen(data, 'memberId', 64) &&
        isOptNum(data, 'totalDistributed') &&
        isOptNum(data, 'trustShare');
    }

    function isValidSpendRecord(data, spendId) {
      return data.keys().hasAll(['id', 'title', 'amount']) &&
        data.keys().hasOnly([
          'id', 'title', 'category', 'amount', 'date', 'description',
          'location', 'beneficiaryCount', 'beneficiaries', 'receiptUrl',
          'paidTo', 'paymentMode', 'remarks', 'createdBy', 'createdAt', 'timestamp'
        ]) &&
        data.id == spendId &&
        isValidId(data.id) &&
        isStrLen(data.title, 1, 200) &&
        (data.amount is int || data.amount is float) &&
        data.amount >= 0 &&
        isOptStrLen(data, 'category', 80) &&
        isOptStrLen(data, 'date', 40) &&
        isOptStrLen(data, 'description', 1000);
    }

    function isValidMediaSubmission(data, mediaId) {
      return data.keys().hasAll(['id', 'mediaUrl', 'status']) &&
        data.keys().hasOnly([
          'id', 'userId', 'memberId', 'userName', 'submittedByName', 'submittedByMemberId',
          'title', 'description', 'caption', 'category', 'location',
          'mediaUrl', 'url', 'mediaType', 'resourceType', 'status',
          'createdAt', 'timestamp', 'updatedAt', 'approvedAt', 'rejectedAt'
        ]) &&
        data.id == mediaId &&
        isValidId(data.id) &&
        isStrLen(data.mediaUrl, 1, 900000) &&
        data.status in ['pending', 'approved', 'rejected'] &&
        isOptStrLen(data, 'userId', 128) &&
        isOptStrLen(data, 'title', 200) &&
        (!('mediaType' in data) || data.mediaType in ['image', 'video']);
    }

    function isValidMediaGalleryItem(data, itemId) {
      return data.keys().hasAll(['id', 'kind']) &&
        data.keys().hasOnly([
          'id', 'kind', 'title', 'subtitle', 'message', 'url', 'imageUrl', 'thumbnailUrl',
          'link', 'category', 'slot', 'active', 'featured', 'createdAt', 'timestamp'
        ]) &&
        data.id == itemId &&
        isValidId(data.id) &&
        data.kind in ['videos', 'posters'] &&
        isOptStrLen(data, 'title', 200) &&
        isOptStrLen(data, 'url', 900000) &&
        (!('active' in data) || data.active is bool) &&
        (!('featured' in data) || data.featured is bool);
    }

    function isValidDailyClosing(data, closingId) {
      return data.keys().hasAll(['date']) &&
        data.keys().hasOnly([
          'date', 'totalJoining', 'totalCommission', 'trustShare',
          'newMembersCount', 'memberReports', 'summary', 'statements',
          'createdAt', 'timestamp', 'status'
        ]) &&
        data.date == closingId &&
        data.date is string &&
        data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        isOptNum(data, 'totalJoining') &&
        isOptNum(data, 'totalCommission') &&
        isOptNum(data, 'trustShare');
    }

    function isValidEventEntry(data, eventId) {
      return data.keys().hasAll(['id', 'title']) &&
        data.keys().hasOnly([
          'id', 'title', 'description', 'date', 'location', 'imageUrl',
          'status', 'createdAt', 'timestamp'
        ]) &&
        data.id == eventId &&
        isValidId(data.id) &&
        isStrLen(data.title, 1, 200) &&
        isOptStrLen(data, 'date', 40);
    }

    function isValidSettingEntry(data, settingId) {
      return data.keys().hasAll(['key']) &&
        data.keys().hasOnly(['key', 'value', 'updatedAt']) &&
        data.key == settingId &&
        isStrLen(data.key, 1, 64) &&
        isOptNum(data, 'updatedAt');
    }

    // 4. Connection Health Endpoint (test/connection)
    match /test/{docId} {
      allow get: if isValidId(docId) && docId == 'connection';
    }

    // 5. Admins Registry (Restricted)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow create, update, delete: if isValidId(adminId) && isAdmin();
    }

    // 6. UCWF Portal Members & Mirror Collections (Schema-Validated Auto-Sync)
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if isPortalReadAllowed();
      allow create: if isValidId(userId) && isValidUser(incoming(), userId);
      allow update: if isValidId(userId) && isValidUser(incoming(), userId) && incoming().uid == existing().uid;
      allow delete: if isValidId(userId);
    }

    match /members/{userId} {
      allow get: if isValidId(userId);
      allow list: if isPortalReadAllowed();
      allow create: if isValidId(userId) && isValidUser(incoming(), userId);
      allow update: if isValidId(userId) && isValidUser(incoming(), userId) && incoming().uid == existing().uid;
      allow delete: if isValidId(userId);
    }

    match /wallets/{userId} {
      allow get: if isValidId(userId);
      allow list: if isPortalReadAllowed();
      allow create: if isValidId(userId) && isValidUser(incoming(), userId);
      allow update: if isValidId(userId) && isValidUser(incoming(), userId) && incoming().uid == existing().uid;
      allow delete: if isValidId(userId);
    }

    // 7. Financial & Payment Ledgers (Schema-Validated Auto-Sync)
    match /payment_requests/{requestId} {
      allow get: if isValidId(requestId);
      allow list: if isPortalReadAllowed();
      allow create: if isValidId(requestId) && isValidPaymentRequest(incoming(), requestId);
      allow update: if isValidId(requestId) &&
        isValidPaymentRequest(incoming(), requestId) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId;
      allow delete: if isValidId(requestId);
    }

    match /withdrawals/{withdrawalId} {
      allow get: if isValidId(withdrawalId);
      allow list: if isPortalReadAllowed();
      allow create: if isValidId(withdrawalId) && isValidWithdrawal(incoming(), withdrawalId);
      allow update: if isValidId(withdrawalId) &&
        isValidWithdrawal(incoming(), withdrawalId) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId;
      allow delete: if isValidId(withdrawalId);
    }

    match /transactions/{transactionId} {
      allow get: if isValidId(transactionId);
      allow list: if isPortalReadAllowed();
      allow create: if isValidId(transactionId) && isValidTransaction(incoming(), transactionId);
      allow update: if isValidId(transactionId) && isValidTransaction(incoming(), transactionId);
      allow delete: if isValidId(transactionId);
    }

    match /payout_records/{recordId} {
      allow get: if isValidId(recordId);
      allow list: if isPortalReadAllowed();
      allow create: if isValidId(recordId) && isValidPayoutRecord(incoming(), recordId);
      allow update: if isValidId(recordId) && isValidPayoutRecord(incoming(), recordId);
      allow delete: if isValidId(recordId);
    }

    match /payout_logs/{logId} {
      allow get: if isValidId(logId);
      allow list: if isPortalReadAllowed();
      allow create: if isValidId(logId) && isValidPayoutRecord(incoming(), logId);
      allow update: if isValidId(logId) && isValidPayoutRecord(incoming(), logId);
      allow delete: if isValidId(logId);
    }

    // 8. Foundation Transparency, Media & Configuration Collections
    match /spends/{spendId} {
      allow get: if isValidId(spendId);
      allow list: if isPortalReadAllowed();
      allow create, update: if isValidId(spendId) && isValidSpendRecord(incoming(), spendId);
      allow delete: if isValidId(spendId);
    }

    match /expenses/{expenseId} {
      allow get: if isValidId(expenseId);
      allow list: if isPortalReadAllowed();
      allow create, update: if isValidId(expenseId) && isValidSpendRecord(incoming(), expenseId);
      allow delete: if isValidId(expenseId);
    }

    match /events/{eventId} {
      allow get: if isValidId(eventId);
      allow list: if isPortalReadAllowed();
      allow create, update: if isValidId(eventId) && isValidEventEntry(incoming(), eventId);
      allow delete: if isValidId(eventId);
    }

    match /daily_closings/{closingId} {
      allow get: if isValidId(closingId);
      allow list: if isPortalReadAllowed();
      allow create, update: if isValidId(closingId) && isValidDailyClosing(incoming(), closingId);
      allow delete: if isValidId(closingId);
    }

    match /media_submissions/{mediaId} {
      allow get: if isValidId(mediaId);
      allow list: if isPortalReadAllowed();
      allow create, update: if isValidId(mediaId) && isValidMediaSubmission(incoming(), mediaId);
      allow delete: if isValidId(mediaId);
    }

    match /media_gallery/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if isPortalReadAllowed();
      allow create, update: if isValidId(itemId) && isValidMediaGalleryItem(incoming(), itemId);
      allow delete: if isValidId(itemId);
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if isPortalReadAllowed();
      allow create, update: if isValidId(settingId) && isValidSettingEntry(incoming(), settingId);
      allow delete: if isValidId(settingId);
    }
  }
}
