{
  "entities": {
    "User": {
      "title": "Member Profile",
      "description": "Uttam Charitable Welfare Foundation member account, sponsor link, package tier, KYC documents, and wallet counters.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberId": { "type": "string", "minLength": 2, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "displayName": { "type": "string", "maxLength": 140 },
        "salutation": { "type": "string", "maxLength": 20 },
        "phone": { "type": "string", "maxLength": 20 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "sponsorId": { "type": "string", "maxLength": 64 },
        "packageTier": { "type": "number" },
        "packageAmount": { "type": "number" },
        "selfBusiness": { "type": "number" },
        "walletBalance": { "type": "number" },
        "totalEarned": { "type": "number" },
        "totalWithdrawn": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "pending", "inactive", "suspended"] },
        "role": { "type": "string", "enum": ["member", "admin"] },
        "is_admin": { "type": "boolean" },
        "timestamp": { "type": "number" }
      },
      "required": ["uid", "memberId", "name", "status"]
    },
    "PaymentRequest": {
      "title": "Payment & Joining Request",
      "description": "Donation / membership fee payment record with UTR and approval state.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "memberId": { "type": "string", "maxLength": 64 },
        "userName": { "type": "string", "maxLength": 140 },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "utrNumber": { "type": "string", "maxLength": 100 },
        "paymentMethod": { "type": "string", "maxLength": 80 },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "userId", "amount", "status"]
    },
    "Withdrawal": {
      "title": "Withdrawal Request",
      "description": "Member commission payout withdrawal request and settlement status.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "memberId": { "type": "string", "maxLength": 64 },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "paid", "rejected"] },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "userId", "amount", "status"]
    },
    "Transaction": {
      "title": "Wallet Transaction",
      "description": "Immutable commission credit or payout debit ledger record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "type": "string", "maxLength": 40 },
        "amount": { "type": "number" },
        "description": { "type": "string", "maxLength": 300 },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "userId", "type", "amount"]
    },
    "PayoutRecord": {
      "title": "Commission Payout Record",
      "description": "12-level commission distribution snapshot triggered by member joining.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberId": { "type": "string", "maxLength": 64 },
        "amount": { "type": "number" },
        "totalDistributed": { "type": "number" },
        "trustShare": { "type": "number" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "amount"]
    },
    "SpendRecord": {
      "title": "Foundation Welfare Spend",
      "description": "Public charitable foundation welfare expenditure record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "category": { "type": "string", "maxLength": 80 },
        "amount": { "type": "number" },
        "date": { "type": "string", "maxLength": 40 },
        "description": { "type": "string", "maxLength": 1000 },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "title", "amount"]
    },
    "MediaSubmission": {
      "title": "Gallery Media Submission",
      "description": "Community event photo or video submitted by members or admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "mediaUrl": { "type": "string", "maxLength": 900000 },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "mediaUrl", "status"]
    },
    "MediaGalleryItem": {
      "title": "Curated Gallery Item",
      "description": "Featured video or poster curated by foundation administrators.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "kind": { "type": "string", "enum": ["videos", "posters"] },
        "title": { "type": "string", "maxLength": 200 },
        "url": { "type": "string", "maxLength": 900000 },
        "active": { "type": "boolean" },
        "featured": { "type": "boolean" }
      },
      "required": ["id", "kind"]
    },
    "DailyClosing": {
      "title": "Daily Closing Summary",
      "description": "12:00 AM IST automated daily closing audit summary.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 20 },
        "totalJoining": { "type": "number" },
        "totalCommission": { "type": "number" },
        "trustShare": { "type": "number" },
        "timestamp": { "type": "number" }
      },
      "required": ["date"]
    },
    "SettingEntry": {
      "title": "Foundation Setting",
      "description": "Configuration entry such as 12-level commission rates or Diwali theme flag.",
      "type": "object",
      "properties": {
        "key": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "number" }
      },
      "required": ["key"]
    },
    "EventEntry": {
      "title": "Foundation Event",
      "description": "Public charitable camp or foundation drive event.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 200 },
        "date": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Member profiles, KYC metadata, sponsor links, and wallet balances."
    },
    "/members/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Legacy mirror collection for member administration."
    },
    "/wallets/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Member wallet summary mirror."
    },
    "/payment_requests/{requestId}": {
      "schema": { "$ref": "#/entities/PaymentRequest" },
      "description": "Membership & donation payment verification records."
    },
    "/withdrawals/{withdrawalId}": {
      "schema": { "$ref": "#/entities/Withdrawal" },
      "description": "Member payout withdrawal requests."
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Wallet credit and debit transaction log."
    },
    "/payout_records/{recordId}": {
      "schema": { "$ref": "#/entities/PayoutRecord" },
      "description": "Automated 12-level commission distribution logs."
    },
    "/payout_logs/{logId}": {
      "schema": { "$ref": "#/entities/PayoutRecord" },
      "description": "Admin manual payout disbursement logs."
    },
    "/spends/{spendId}": {
      "schema": { "$ref": "#/entities/SpendRecord" },
      "description": "Public foundation welfare expenditure transparency entries."
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/SpendRecord" },
      "description": "Operational program expense entries."
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/EventEntry" },
      "description": "Public charitable event calendar items."
    },
    "/daily_closings/{closingId}": {
      "schema": { "$ref": "#/entities/DailyClosing" },
      "description": "Midnight IST daily closing accounting records."
    },
    "/media_submissions/{mediaId}": {
      "schema": { "$ref": "#/entities/MediaSubmission" },
      "description": "Community gallery submissions awaiting or granted approval."
    },
    "/media_gallery/{itemId}": {
      "schema": { "$ref": "#/entities/MediaGalleryItem" },
      "description": "Featured videos and campaign posters."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/SettingEntry" },
      "description": "Commission rate tables, theme flags, and closing cursor."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Authorized admin UID registry."
    },
    "/test/{docId}": {
      "schema": { "$ref": "#/entities/SettingEntry" },
      "description": "Firestore connectivity check endpoint."
    }
  }
}
